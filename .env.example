# ───────────────────────── GuildSmith config ─────────────────────────
# Copy this file to ".env" and fill in at least DISCORD_TOKEN.

# Bot token: https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Optional: your test server's ID. Slash commands then appear there instantly.
# (Right-click the server icon → Copy Server ID. Needs Developer Mode: User Settings → Advanced.)
# Leave EMPTY when running 24/7 so commands work in every server.
DEV_GUILD_ID=

# Display name used in messages
BOT_NAME=GuildSmith

# ───────────────────────── AI defaults ─────────────────────────
# Provider for servers that never ran /provider. Options:
# ollama, gemini, grok, groq, openai, anthropic, openrouter, fal, qwen, deepseek, mistral, zai
DEFAULT_PROVIDER=ollama

# Local Ollama (free, no API key). Install from https://ollama.com/download
OLLAMA_URL=http://127.0.0.1:11434
# Small models for old PCs: qwen3:1.7b (~2 GB RAM), qwen3:4b (~4 GB), qwen3:8b (~6 GB, much smarter)
OLLAMA_MODEL=qwen3:4b
# Minimum context window. It grows automatically for big servers (more RAM).
OLLAMA_NUM_CTX=8192
# How many AI requests Ollama handles at once. Others wait in a queue.
OLLAMA_CONCURRENCY=1
# Download the model automatically the first time it's used
OLLAMA_AUTO_PULL=true

# Optional bot-owner API keys. Servers without their own /provider key fall back to these.
# Admins can always set their own key with /provider set (stored encrypted).
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
FAL_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=

# Optional endpoint overrides
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   (China region)
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4                  (GLM Coding Plan)

# ───────────────────────── Advanced ─────────────────────────
# Where settings live (db.json + secret.key). Back this folder up!
DATA_DIR=./data
# Secret used to encrypt stored API keys. Empty = auto-generated into DATA_DIR/secret.key
ENCRYPTION_KEY=
# Safety cap on steps per AI plan
MAX_ACTIONS_PER_PLAN=150
# debug | info | warn | error
LOG_LEVEL=info
